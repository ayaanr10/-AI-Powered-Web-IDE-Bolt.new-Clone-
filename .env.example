# Local Zap generation uses the Gemini key on the Express server only.
# Never paste a real key into chat, a VITE_* variable, or a committed file.
GEMINI_API_KEY=
# Choose a supported model available to your Google AI Studio key.
GEMINI_MODEL=gemini-3.8-flash
# Free Cloudflare Turnstile bot check for the public Render demo.
# Create a widget for the Buildora hostname and keep the secret server-side.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
PORT=3001
