# Local Zap generation uses the Gemini key on the Express server only.
# Never paste a real key into chat, a VITE_* variable, or a committed file.
GEMINI_API_KEY=
# Choose a supported model available to your Google AI Studio key.
GEMINI_MODEL=gemini-3.8-flash
# Production-only abuse protection. Local development uses a small in-memory limiter.
# Production requires a persistent Render Key Value connection and Cloudflare Turnstile.
REDIS_URL=
SESSION_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
PORT=3001
